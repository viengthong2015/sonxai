# Copy to .env and adjust. Never commit the real .env file.
ENVIRONMENT=development

# PostgreSQL connection (SQLAlchemy URL, psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:dhis2@localhost:5432/sonxai1

# Long random string used to sign session tokens.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me

# Session lifetime in minutes (default 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Set to true when the site is served over HTTPS
COOKIE_SECURE=false

# Allowed browser origins for the API (JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Max upload size for images in megabytes
MAX_UPLOAD_MB=5

# First administrator account, created by `python -m app.seed` when no users exist
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-this-password
